CREATE OR REPLACE DATABASE HOTEL_DB;

USE DATABASE HOTEL_DB;

-- =========================================================
-- CREATE FILE FORMAT
-- =========================================================

CREATE OR REPLACE FILE FORMAT FF_CSV
TYPE = 'CSV'
FIELD_OPTIONALLY_ENCLOSED_BY = '"'
SKIP_HEADER = 1
NULL_IF = ('NULL', 'null', '');

-- =========================================================
-- CREATE STAGE
-- =========================================================

CREATE OR REPLACE STAGE STG_HOTEL_BOOKINGS
FILE_FORMAT = FF_CSV;

-- =========================================================
-- BRONZE TABLE (RAW DATA)
-- =========================================================

CREATE OR REPLACE TABLE BRONZE_HOTEL_BOOKING (
    booking_id STRING,
    hotel_id STRING,
    hotel_city STRING,
    customer_id STRING,
    customer_name STRING,
    customer_email STRING,
    check_in_date STRING,
    check_out_date STRING,
    room_type STRING,
    num_guests STRING,
    total_amount STRING,
    currency STRING,
    booking_status STRING
);

-- =========================================================
-- LOAD RAW DATA TO BRONZE
-- =========================================================

COPY INTO BRONZE_HOTEL_BOOKING
FROM @STG_HOTEL_BOOKINGS
FILE_FORMAT = (FORMAT_NAME = FF_CSV)
ON_ERROR = 'CONTINUE';

-- =========================================================
-- ERROR TABLE
-- =========================================================

CREATE OR REPLACE TABLE HOTEL_BOOKING_ERRORS (
    booking_id STRING,
    error_reason STRING,
    load_time TIMESTAMP
);

-- =========================================================
-- SILVER TABLE (CLEANED DATA)
-- =========================================================

CREATE OR REPLACE TABLE SILVER_HOTEL_BOOKINGS (
    booking_id VARCHAR,
    hotel_id VARCHAR,
    hotel_city VARCHAR,
    customer_id VARCHAR,
    customer_name VARCHAR,
    customer_email VARCHAR,
    check_in_date DATE,
    check_out_date DATE,
    room_type VARCHAR,
    num_guests INTEGER,
    total_amount FLOAT,
    currency VARCHAR,
    booking_status VARCHAR
);

-- =========================================================
-- STORE INVALID EMAIL RECORDS
-- =========================================================

INSERT INTO HOTEL_BOOKING_ERRORS
SELECT
    booking_id,
    'Invalid Email',
    CURRENT_TIMESTAMP()
FROM BRONZE_HOTEL_BOOKING
WHERE customer_email NOT LIKE '%@%.%'
   OR customer_email IS NULL;

-- =========================================================
-- STORE INVALID DATE RECORDS
-- =========================================================

INSERT INTO HOTEL_BOOKING_ERRORS
SELECT
    booking_id,
    'Invalid Check-in / Check-out Dates',
    CURRENT_TIMESTAMP()
FROM BRONZE_HOTEL_BOOKING
WHERE TRY_TO_DATE(check_out_date)
    < TRY_TO_DATE(check_in_date);

-- =========================================================
-- STORED PROCEDURE FOR SILVER LOAD
-- =========================================================

CREATE OR REPLACE PROCEDURE LOAD_SILVER_LAYER()
RETURNS STRING
LANGUAGE SQL
AS
$$
BEGIN

INSERT INTO SILVER_HOTEL_BOOKINGS

SELECT
    booking_id,

    hotel_id,

    INITCAP(TRIM(hotel_city)) AS hotel_city,

    customer_id,

    INITCAP(TRIM(customer_name)) AS customer_name,

    CASE
        WHEN customer_email LIKE '%@%.%'
        THEN LOWER(TRIM(customer_email))
        ELSE NULL
    END AS customer_email,

    TRY_TO_DATE(NULLIF(check_in_date, '')) AS check_in_date,

    TRY_TO_DATE(NULLIF(check_out_date, '')) AS check_out_date,

    INITCAP(TRIM(room_type)) AS room_type,

    TRY_TO_NUMBER(num_guests) AS num_guests,

    ABS(TRY_TO_NUMBER(total_amount)) AS total_amount,

    UPPER(TRIM(currency)) AS currency,

    CASE
        WHEN LOWER(booking_status)
            IN ('confirmeeed', 'confirmd')
        THEN 'Confirmed'

        ELSE INITCAP(TRIM(booking_status))
    END AS booking_status

FROM BRONZE_HOTEL_BOOKING

WHERE
    TRY_TO_DATE(check_in_date) IS NOT NULL
    AND TRY_TO_DATE(check_out_date) IS NOT NULL
    AND TRY_TO_DATE(check_out_date)
        >= TRY_TO_DATE(check_in_date);

RETURN 'Silver Layer Loaded Successfully';

END;
$$;

-- =========================================================
-- EXECUTE PROCEDURE
-- =========================================================

CALL LOAD_SILVER_LAYER();

-- =========================================================
-- CREATE STREAM ON BRONZE TABLE
-- =========================================================

CREATE OR REPLACE STREAM STR_HOTEL_BOOKINGS
ON TABLE BRONZE_HOTEL_BOOKING;

-- =========================================================
-- TASK FOR INCREMENTAL LOAD
-- =========================================================

CREATE OR REPLACE TASK TASK_INCREMENTAL_SILVER_LOAD
WAREHOUSE = COMPUTE_WH
SCHEDULE = '5 MINUTE'
AS

INSERT INTO SILVER_HOTEL_BOOKINGS

SELECT
    booking_id,

    hotel_id,

    INITCAP(TRIM(hotel_city)),

    customer_id,

    INITCAP(TRIM(customer_name)),

    LOWER(TRIM(customer_email)),

    TRY_TO_DATE(check_in_date),

    TRY_TO_DATE(check_out_date),

    INITCAP(TRIM(room_type)),

    TRY_TO_NUMBER(num_guests),

    ABS(TRY_TO_NUMBER(total_amount)),

    UPPER(TRIM(currency)),

    INITCAP(TRIM(booking_status))

FROM STR_HOTEL_BOOKINGS

WHERE
    TRY_TO_DATE(check_in_date) IS NOT NULL
    AND TRY_TO_DATE(check_out_date) IS NOT NULL;

-- =========================================================
-- START TASK
-- =========================================================

ALTER TASK TASK_INCREMENTAL_SILVER_LOAD RESUME;

-- =========================================================
-- SNOWPIPE FOR AUTO FILE INGESTION
-- =========================================================

CREATE OR REPLACE PIPE PIPE_HOTEL_BOOKINGS
AS

COPY INTO BRONZE_HOTEL_BOOKING
FROM @STG_HOTEL_BOOKINGS
FILE_FORMAT = (FORMAT_NAME = FF_CSV)
ON_ERROR = 'CONTINUE';

-- =========================================================
-- GOLD TABLE - DAILY BOOKINGS
-- =========================================================

CREATE OR REPLACE TABLE GOLD_AGG_DAILY_BOOKING AS

SELECT
    check_in_date AS booking_date,
    COUNT(*) AS total_bookings,
    SUM(total_amount) AS total_revenue

FROM SILVER_HOTEL_BOOKINGS
GROUP BY check_in_date
ORDER BY booking_date;

-- =========================================================
-- GOLD TABLE - HOTEL CITY SALES
-- =========================================================

CREATE OR REPLACE TABLE GOLD_AGG_HOTEL_CITY_SALES AS

SELECT
    hotel_city,
    SUM(total_amount) AS total_revenue

FROM SILVER_HOTEL_BOOKINGS
GROUP BY hotel_city
ORDER BY total_revenue DESC;

-- =========================================================
-- GOLD CLEAN TABLE
-- =========================================================

CREATE OR REPLACE TABLE GOLD_BOOKING_CLEAN AS

SELECT *
FROM SILVER_HOTEL_BOOKINGS;

-- =========================================================
-- DYNAMIC TABLE
-- AUTO REFRESHES AGGREGATED SALES
-- =========================================================

CREATE OR REPLACE DYNAMIC TABLE DT_HOTEL_CITY_SALES
TARGET_LAG = '1 minute'
WAREHOUSE = COMPUTE_WH

AS

SELECT
    hotel_city,
    SUM(total_amount) AS total_revenue,
    COUNT(*) AS total_bookings

FROM SILVER_HOTEL_BOOKINGS
GROUP BY hotel_city;

-- =========================================================
-- VALIDATION QUERIES
-- =========================================================

SELECT * FROM BRONZE_HOTEL_BOOKING LIMIT 20;

SELECT * FROM SILVER_HOTEL_BOOKINGS LIMIT 20;

SELECT * FROM GOLD_AGG_DAILY_BOOKING LIMIT 20;

SELECT * FROM GOLD_AGG_HOTEL_CITY_SALES LIMIT 20;

SELECT * FROM DT_HOTEL_CITY_SALES LIMIT 20;

SELECT * FROM GOLD_BOOKING_CLEAN LIMIT 20;

